# Backend-only secrets and provider configuration. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# OpenStreetMap-compatible development providers
MAP_PROVIDER=OPENSTREETMAP
MAP_USER_AGENT=EVACAI/1.0 (local development contact: replace-with-your-email@example.com)

# Restrict browser access in deployments; comma-separated origins are supported.
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional integration credentials. Empty values deliberately result in UNAVAILABLE states.
SENSOR_API_TOKEN=
CAMERA_API_URL=
CAMERA_USERNAME=
CAMERA_PASSWORD=
DATABASE_URL=
