# Backend-only secrets and provider configuration. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# OpenStreetMap-compatible providers. These are public map services and do not require a secret.
MAP_PROVIDER=OPENSTREETMAP
MAP_USER_AGENT=EVACAI/1.0

# Browser-access allowlist. For Vercel production, set the exact deployed origin.
APP_ORIGIN=https://aies-verse.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Optional integration credentials. Empty values deliberately result in UNAVAILABLE states.
SENSOR_API_TOKEN=
CAMERA_API_URL=
CAMERA_USERNAME=
CAMERA_PASSWORD=
DATABASE_URL=

# Optional frontend override for app API base URL.
# VITE_API_BASE_URL=
